<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Constructor-injected Spring beans store their collaborators by design; that's dependency
         injection, not exposed mutable state. SpotBugs raises EI_EXPOSE_REP2 whenever a bean stores
         a constructor-injected collaborator such as a concrete service (HueBridgeService,
         MqttConnection) or a Spring Data repository; the classes below are the ones it flags. The
         check stays active everywhere else (e.g., the response/request DTOs still need defensive
         copies). -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Or>
            <Class name="org.felixgeisler.smarthome.automation.AutomationController"/>
            <Class name="org.felixgeisler.smarthome.automation.DeviceCommandActionHandler"/>
            <Class name="org.felixgeisler.smarthome.automation.DeviceStateConditionHandler"/>
            <Class name="org.felixgeisler.smarthome.automation.DeviceToggleActionHandler"/>
            <Class name="org.felixgeisler.smarthome.dashboard.DashboardLayoutService"/>
            <Class name="org.felixgeisler.smarthome.device.DeviceController"/>
            <Class name="org.felixgeisler.smarthome.device.DeviceReachabilityMonitor"/>
            <Class name="org.felixgeisler.smarthome.device.DeviceStatePoller"/>
            <Class name="org.felixgeisler.smarthome.floor.FloorController"/>
            <Class name="org.felixgeisler.smarthome.integration.homematic.HomematicCcuService"/>
            <Class name="org.felixgeisler.smarthome.integration.homematic.HomematicController"/>
            <Class name="org.felixgeisler.smarthome.integration.homematic.HomematicDeviceAdapter"/>
            <Class name="org.felixgeisler.smarthome.integration.homematic.HomematicSensorPoller"/>
            <Class name="org.felixgeisler.smarthome.integration.hue.HueBridgeService"/>
            <Class name="org.felixgeisler.smarthome.integration.hue.HueController"/>
            <Class name="org.felixgeisler.smarthome.integration.hue.HueDeviceAdapter"/>
            <Class name="org.felixgeisler.smarthome.integration.mqtt.MqttConnection"/>
            <Class name="org.felixgeisler.smarthome.integration.mqtt.MqttController"/>
            <Class name="org.felixgeisler.smarthome.integration.mqtt.MqttSensorListener"/>
            <Class name="org.felixgeisler.smarthome.integration.shelly.ShellyMeterPoller"/>
            <Class name="org.felixgeisler.smarthome.integration.solakon.SolakonConnection"/>
            <Class name="org.felixgeisler.smarthome.integration.solakon.SolakonController"/>
            <Class name="org.felixgeisler.smarthome.room.RoomController"/>
            <Class name="org.felixgeisler.smarthome.room.RoomLayoutService"/>
            <Class name="org.felixgeisler.smarthome.telemetry.SensorReadingRecorder"/>
            <Class name="org.felixgeisler.smarthome.telemetry.TelemetryHistoryService"/>
            <Class name="org.felixgeisler.smarthome.telemetry.TelemetryRetentionJob"/>
            <Class name="org.felixgeisler.smarthome.realtime.DeviceEventStreamController"/>
        </Or>
    </Match>

    <!-- A JPA @ManyToOne association is a shared entity reference, not owned data. Returning or
         storing the associated entity is the association working as intended; a defensive copy would
         break its entity identity. So EI_EXPOSE_REP/REP2 on these association accessors is a false
         positive. (Once the referenced entity holds a mutable field of its own, SpotBugs starts
         treating it as mutable and flags the accessor, which is why this appears for the room and
         floor links but not, say, an int-and-string-only entity.) -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="org.felixgeisler.smarthome.device.Device"/>
        <Or>
            <Method name="getRoom"/>
            <Method name="assignRoom"/>
        </Or>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="org.felixgeisler.smarthome.room.Room"/>
        <Or>
            <Method name="getFloor"/>
            <Method name="assignFloor"/>
        </Or>
    </Match>

    <!-- Modbus TCP is an inherently unencrypted, plaintext protocol; the target inverter exposes no
         TLS variant, so the client that speaks it must open a plain socket. That is mandated by the
         protocol, not an oversight, so UNENCRYPTED_SOCKET is excluded for that one client only. -->
    <Match>
        <Bug pattern="UNENCRYPTED_SOCKET"/>
        <Class name="org.felixgeisler.smarthome.integration.solakon.ModbusTcpClient"/>
    </Match>
</FindBugsFilter>
